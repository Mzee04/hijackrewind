# HijackRewind configuration. Copy to .env and fill in only what you use.
# The sandbox default needs no tokens. Never commit .env.

# sandbox (default) talks to the local stub and may auto-execute one
# verified unknown SSH-key delete. dry-run stops after the plan.
# live is optional and uses GITHUB_TOKEN against one test account.
HIJACKREWIND_MODE=sandbox

# Local GitHub-shaped stub started by docker compose or `hijackrewind demo`.
HIJACKREWIND_STUB_URL=http://127.0.0.1:8088

# Optional live mode. Leave the token blank for the sandbox default.
# Classic PAT: admin:public_key for SSH keys, user for account emails.
# Fine-grained PAT: Git SSH keys (write), Email addresses (write),
# and for a test repo: Administration / Webhooks / Deploy keys as needed.
# This token can only do what GitHub allows a normal user token to do.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Repo-scoped reverts are limited to this one repository.
TEST_REPO_OWNER=test-owner
TEST_REPO_NAME=test-repo

# Objects listed here are never deleted.
HIJACKREWIND_MANIFEST=sandbox/fixtures/known-good.json

# Domains allowed to raise an actionable account alert. Subdomains count.
# A lookalike such as github.com.evil.test does not.
HIJACKREWIND_SENDER_ALLOWLIST=github.com

# Demo policy: in sandbox or live mode, one verified unknown SSH key
# may be deleted without a second click. Every other mutate needs
# `hijackrewind approve PLAN_ID`. Set to false to plan only.
HIJACKREWIND_AUTO_EXECUTE_SSH_KEY=true

# Maximum mutating API calls in a single run.
HIJACKREWIND_MUTATE_CAP=1

# Dashboard binds to localhost so approve and kill are not remote.
HIJACKREWIND_DASHBOARD_HOST=127.0.0.1
HIJACKREWIND_DASHBOARD_PORT=8765

# Optional LLM. Off by default. It may draft a sentence for the operator.
# It cannot authorize a mutate. Leave the key blank unless you opt in.
HIJACKREWIND_LLM_ENABLED=false
HIJACKREWIND_LLM_BASE_URL=
HIJACKREWIND_LLM_API_KEY=
HIJACKREWIND_LLM_MODEL=

# Optional Mailpit inbox (docker compose). File ingest works without it.
MAILPIT_URL=http://127.0.0.1:8025

# Traces and the append-only audit log.
HIJACKREWIND_TRACE_DIR=traces
HIJACKREWIND_AUDIT_LOG=.hijackrewind/audit.jsonl
HIJACKREWIND_HOME=.hijackrewind
